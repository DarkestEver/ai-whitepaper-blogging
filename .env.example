# Local admin session signing key; use a fresh random value of at least 32 bytes.
SESSION_SECRET=

# Generate with: npm run admin:hash (supply the password through stdin).
ADMIN_PASSWORD_HASH=

# MongoDB connection string. Required.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=wpblog

# Optional metadata fallback origin. The admin site's Public base URL is used
# for configured homepage/article canonicals and article social image URLs.
# Host-based multi-site resolution is not implemented.
PUBLIC_BASE_URL=http://localhost:3000

#local-prototype-password

# Per-domain email secret values are referenced by each site's emailSecretRef.
# Example: SITE_ALPHA_EMAIL_TOKEN=replace-with-provider-secret

# Required production readiness infrastructure (not used by the local prototype):
RATE_LIMIT_STORE_URL=
PRIVATE_OBJECT_STORAGE_URL=
